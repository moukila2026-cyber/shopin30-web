# SHOPIN30 — configuration Supabase
#
# Production (Vercel) : ajoutez ces variables dans Project Settings → Environment Variables.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<clé service_role du projet — serveur uniquement>
#
# Développement local avec Vite (optionnel) : pour envoyer directement avec la clé anon,
# appliquez d'abord la migration dans supabase/migrations/.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<clé publique anon du projet>
#
# Ne préfixez JAMAIS SUPABASE_SERVICE_ROLE_KEY avec VITE_ et ne la commitez pas.
